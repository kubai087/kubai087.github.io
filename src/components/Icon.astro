---
/* Inline icons, drawn on a 24px grid. */
interface Props {
  name: "arrow" | "copy" | "check" | "close" | "qr";
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class:list={["icon", className]}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === "arrow" && <path d="M7 17 17 7M9 7h8v8" />}
  {name === "copy" && (
    <>
      <rect x="8.5" y="8.5" width="11" height="11" rx="2.5" />
      <path d="M15.5 8.5V7a2.5 2.5 0 0 0-2.5-2.5H7A2.5 2.5 0 0 0 4.5 7v6A2.5 2.5 0 0 0 7 15.5h1.5" />
    </>
  )}
  {name === "check" && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
  {name === "qr" && (
    <>
      <rect x="4" y="4" width="6" height="6" rx="1.2" />
      <rect x="14" y="4" width="6" height="6" rx="1.2" />
      <rect x="4" y="14" width="6" height="6" rx="1.2" />
      <path d="M14 14h2.5v2.5H14zM17.5 17.5H20V20h-2.5zM14 19.5h.01M19.5 14h.01" />
    </>
  )}
</svg>
